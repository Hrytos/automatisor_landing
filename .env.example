# Copy to .env. server.js loads .env on startup. .env is gitignored.

# Same Function URL as VITE_OPENAI_LAMBDA_URL in the product app.
OPENAI_LAMBDA_URL=https://your-function-url.lambda-url.us-east-1.on.aws/openai/chat

# Read-only. The questioner loads research for the default accounts in
# server/ifp/defaultApprovalPortfolio.json. Those accounts are not ranked or saved.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Work-email reveal inserts domain + email into landing_page_ifp (anon insert).
# Vendor cache (offerings, fits map, latest questioner) lives in landing_ifp_master
# and is read/written by the server with one of:
#   SUPABASE_SERVICE_ROLE_KEY  (recommended for local + Lambda), or
#   SUPABASE_EMAIL + SUPABASE_PASSWORD  (service user; authenticated select policy).
# Without either, step 1 always runs the solution finder on the web.
# See supabase/migrations/20260412120000_landing_page_ifp_cache_columns.sql.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_EMAIL=
# SUPABASE_PASSWORD=

# Optional. Defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna

# Landing IFP Lambda only (lambda/template.yaml). That function calls OpenAI itself.
# Leave this empty to keep the local server on the product proxy.
# OPENAI_API_KEY=
