            <tr><td><span class="compare-feature-cell"><span class="compare-feature-name">List building</span></span></td><td><span class="compare-cross"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.7 2.7l6.6 6.6M9.3 2.7l-6.6 6.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span></td><td><span class="compare-value">Apollo via MCP</span></td></tr>
            <tr><td><span class="compare-feature-cell"><span class="compare-feature-name">Contact Enrichment</span></span></td><td><span class="compare-cross"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.7 2.7l6.6 6.6M9.3 2.7l-6.6 6.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span></td><td><span class="compare-value">Apollo, FullEnrich</span></td></tr>
            <tr><td><span class="compare-feature-cell"><span class="compare-feature-name">Email Delivery</span></span></td><td><span class="compare-value">SmartLead, Instantly</span></td><td><span class="compare-value">SmartLead, Instantly, HubSpot</span></td></tr>
            <tr><td><span class="compare-feature-cell"><span class="compare-feature-name">Linkedin Outreach</span></span></td><td><span class="compare-cross"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.7 2.7l6.6 6.6M9.3 2.7l-6.6 6.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span></td><td><span class="compare-value">HeyReach</span></td></tr>
            <tr><td><span class="compare-feature-cell"><span class="compare-feature-name">Calling</span></span></td><td><span class="compare-cross"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.7 2.7l6.6 6.6M9.3 2.7l-6.6 6.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span></td><td><span class="compare-value">Gong</span></td></tr>
            <tr><td><span class="compare-feature-cell"><span class="compare-feature-name">Intent Signals</span><span class="compare-feature-desc">Known champion movement, keyword searches, website visitors, chat conversations, event attendance, engament on marketing material - success stories, white papers, RoI calculators etc</span></span></td><td><span class="compare-cross"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.7 2.7l6.6 6.6M9.3 2.7l-6.6 6.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span></td><td><span class="compare-cross"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.7 2.7l6.6 6.6M9.3 2.7l-6.6 6.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span></td><td><span class="compare-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 6.3l2.4 2.4 4.6-5.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></td></tr>
