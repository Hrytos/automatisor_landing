            <tr class="group-row"><td colspan="4"><span class="group-row-body"><span class="group-row-title-row"><span class="group-row-title">Prospecting Copilot</span></span><span class="group-row-desc">Automatically build your deal pipeline</span></span></td></tr>
            <tr><td><span class="compare-feature-cell"><span class="compare-feature-name">Discover</span><span class="compare-feature-desc">Sources warehousing facilities to build your funnel</span></span></td><td><span class="compare-value">Basic</span></td><td><span class="compare-value">Advanced</span></td><td><span class="compare-value">Advanced</span></td></tr>
