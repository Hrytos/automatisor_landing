            <tr class="group-row"><td colspan="4"><span class="group-row-body"><span class="group-row-title-row"><span class="group-row-title">Facility Intelligence</span></span><span class="group-row-desc">Uncover high potential revenue opportunites</span></span></td></tr>
            <tr><td><span class="compare-feature-cell"><span class="compare-feature-name">Account Sense</span><span class="compare-feature-desc">Researches and profiles target accounts into Strategic, Key & Territory</span></span></td><td><span class="compare-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 6.3l2.4 2.4 4.6-5.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></td><td><span class="compare-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 6.3l2.4 2.4 4.6-5.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></td><td><span class="compare-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 6.3l2.4 2.4 4.6-5.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></td></tr>
