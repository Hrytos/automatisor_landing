<%- include('partials/warehouse-research') %>

  <%- include('partials/signal-section') %>

  <%- include('partials/engine-section', {
    engineHeading: 'Scale warehouse acquisition with Facility Intelligence',
    engineParagraph: "Which warehouse opportunity do you definitely want to close? <br><br>Identify warehouses worth pursuing, uncover why they are strong automation candidates and prepare for discovery. <br><br> No obligations, no credit card.",
