  <section class="criteria-section">
    <div class="container">
      <div class="section-head section-head-center">
        <div class="tag-pill"><span class="dot"></span>ICP MATCHING</div>
        <h2>Screen Thousands Against Your Criteria</h2>
        <p>You tell us your thesis. The software compares every company against it, line by line.</p>
      </div>

      <div class="criteria-list">
        <div class="criteria-row">
          <p><strong>B2B SaaS company in the Healthcare EHR space, 200-1000 employees and last raised between
            Series A and Series C</strong> — the target operates a multi-tenant clinical platform sold to mid-market
            hospital systems, with headcount growth over 40% in the trailing twelve months.</p>
          <span class="pill pill-green">92% MATCH</span>
        </div>
        <div class="criteria-row">
          <p><strong>End of Diagnostic Devices FDA-cleared class II device manufacturer</strong> — company holds an
            active 510(k) clearance, ships to at least three distribution regions, and has filed for a follow-on
            clearance in the last eighteen months.</p>
          <span class="pill pill-green">88% MATCH</span>
        </div>
        <div class="criteria-row">
          <p><strong>Vendor of Revenue Cycle Management SaaS software with $10M-$50M in annual recurring revenue
            and a self-serve onboarding motion</strong> — sales-led growth with a dedicated partnerships team and
            documented API integrations.</p>
          <span class="pill pill-green">81% MATCH</span>
        </div>
        <div class="criteria-row">
          <p><strong>Lead completed a Series C round led by a healthcare-focused fund within the last 90
            days</strong> — publicly announced financing, use-of-funds language referencing go-to-market expansion.</p>
          <span class="pill pill-green">77% MATCH</span>
        </div>
        <div class="criteria-row">
          <p><strong>Facilities office DIY care network operating fewer than five locations and no digital
            intake system</strong> — no recent hiring signal, no technology stack disclosed, headcount under
            growth threshold.</p>
          <span class="pill pill-red">NO MATCH</span>
        </div>
      </div>
    </div>
  </section> 
  -->

<%- include('partials/warehouse-research') %>

  <%- include('partials/signal-section') %>

  <%- include('partials/engine-section', {
    engineHeading: 'Scale warehouse acquisition with Facility Intelligence',
    engineParagraph: "Which warehouse opportunity do you definitely want to close? <br><br>Identify warehouses worth pursuing, uncover why they are strong automation candidates and prepare for discovery. <br><br> No obligations, no credit card.",
    engineCtaHref: 'https://app.automatisor.com',
    engineCtaText: 'Start Free Trial'
  }) %>

 

</main>

<%- include('partials/footer') %>

<%- include('partials/persona-overlay') %>

<script src="/js/chat-demo.js"></script>
<script src="/js/source-map.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
