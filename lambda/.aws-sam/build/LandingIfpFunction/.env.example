# Copy to .env. server.js loads .env on startup. .env is gitignored.

# Same Function URL as VITE_OPENAI_LAMBDA_URL in the product app.
OPENAI_LAMBDA_URL=https://your-function-url.lambda-url.us-east-1.on.aws/openai/chat

# Read-only. The questioner loads research for the default accounts in
# server/ifp/defaultApprovalPortfolio.json. Those accounts are not ranked or saved.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# The reveal step inserts domain + work email into public.landing_page_ifp with this anon key.
# The table needs an insert policy for the anon role and no select policy.

# Optional. Defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna

# Landing IFP Lambda only (lambda/template.yaml). That function calls OpenAI itself.
# Leave this empty to keep the local server on the product proxy.
# OPENAI_API_KEY=
